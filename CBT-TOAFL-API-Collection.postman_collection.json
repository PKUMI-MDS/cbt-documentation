  "info": {
    "_postman_id": "cbt-toafl-api-v1",
    "name": "CBT-TOAFL API Collection",
    "description": "Complete API collection for CBT-TOAFL (Backend Laravel 13).\n\nAuth:\n- Public endpoints: no auth required\n- User endpoints: Bearer token via Sanctum (header: Authorization: Bearer {{token}})\n- Admin endpoints: Bearer token + role=admin\n\nVariables:\n- base_url: Backend base URL (e.g. http://localhost:8000)\n- token: Sanctum bearer token obtained from /api/login",
